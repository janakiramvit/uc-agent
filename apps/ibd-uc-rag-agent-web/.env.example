# IBD/UC Evidence Agent (Next.js + LangGraph) -- environment configuration.
#
# All credentials are provided via environment variables ONLY. Nothing in
# this codebase hard-codes an API key. Copy this file to .env.local for
# local development, or set these in the Vercel project's Environment
# Variables settings for deployment.

# --- LLM provider (required for the evidence_synthesizer node) ---
# Set ONE of these. If ANTHROPIC_API_KEY is set, it takes priority.
# With neither set, the agent still runs end-to-end (planning, retrieval,
# applicability checks, conflict/gap detection, safety boundaries) but
# returns an explicit "llm_unavailable" status instead of fabricating an
# answer once it reaches the synthesis step.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults shown)
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini

# --- Vector retrieval (optional) ---
# Vector retrieval reuses OPENAI_API_KEY for embeddings (text-embedding-3-small).
# If OPENAI_API_KEY is not set, vector retrieval reports
# vectorRetrievalStatus="unavailable_no_api_key" and the pipeline continues
# on BM25 retrieval alone -- it never silently fakes a vector match.
