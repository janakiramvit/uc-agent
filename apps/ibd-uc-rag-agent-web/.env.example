# IBD/UC Evidence Agent (Next.js + model-powered LangGraph) -- environment
# configuration.
#
# All credentials are provided via environment variables ONLY. Nothing in
# this codebase hard-codes an API key or model name (only safe, documented
# fallback model names live in agent_core/model_router.py, and even those
# are overridden the moment the matching env var is set). Copy this file to
# .env.local for local development, or set these in the Vercel project's
# Environment Variables settings for deployment.

# --- Provider credentials ---
# Set the key(s) matching whichever provider(s) your *_PROVIDER vars below
# select. Both may be set at once (e.g. to run OpenAI synthesis alongside
# Anthropic reasoning). With neither key present for a category's selected
# provider, that node fails safe to its deterministic fallback (or, for the
# synthesis category specifically -- the only node whose output IS the
# final answer -- an explicit "llm_unavailable" status, never a fabricated
# answer).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Per-node-category model routing ---
# Four independent routing categories map every model-powered node to a
# provider + model pair. Provider must be "openai" or "anthropic". Unset
# vars fall back to a safe default (see agent_core/model_router.py):
# anthropic for every category, with a cheap/fast model for planner and a
# stronger model for reasoning/synthesis/critic.
#
#   category    used by                                              default (unset)
#   ----------  ---------------------------------------------------  ---------------------------
#   planner     planner, query classifier, query reformulator        anthropic / claude-haiku-4-5
#   reasoning   evidence analyst, conflict resolver                  anthropic / claude-sonnet-4-5
#   synthesis   grounded synthesizer (the final answer text itself)  anthropic / claude-sonnet-4-5
#   critic      citation reviewer, safety critic, QA evaluator       anthropic / claude-sonnet-4-5
PLANNER_PROVIDER=
PLANNER_MODEL=
REASONING_PROVIDER=
REASONING_MODEL=
SYNTHESIS_PROVIDER=
SYNTHESIS_MODEL=
CRITIC_PROVIDER=
CRITIC_MODEL=

# --- Evidence backend (dormant Supabase path) ---
# Retrieval reads the fixed JSON file by default. The Supabase-backed path
# (agent_core/supabase_evidence_source.py) is reachable ONLY when BOTH vars below
# are set, and only after the migration gate in db/PLAN-v1.0.0.md has passed.
# Leave all three blank for normal operation.
EVIDENCE_BACKEND=file
EVIDENCE_SUPABASE_ENABLED=
# Server-side ONLY. Never expose to the client bundle / never prefix NEXT_PUBLIC_.
# Connect as the least-privilege role `evidence_reader` (SELECT on canonical.v_* only).
EVIDENCE_SUPABASE_DB_URL=

# --- Vector retrieval (optional, separate from the routing above) ---
# Vector retrieval always uses OPENAI_API_KEY for embeddings
# (text-embedding-3-small) regardless of which provider the routing
# categories above select -- Anthropic has no public embeddings API. If
# OPENAI_API_KEY is not set, vector retrieval reports
# vectorRetrievalStatus="unavailable_no_api_key" and fusion degrades to a
# pure BM25 passthrough -- it never silently fakes a vector match.
