# IBD/UC RAG prototype -- environment configuration example.
#
# Copy this file to .env if you want to override defaults. By default
# NO model/API calls are made anywhere in this prototype: retrieval is
# local BM25 (LangChain) and answer composition is deterministic,
# template-based text assembled directly from the reviewed evidence
# fields. The app runs and answers correctly with zero model calls and
# zero API keys.
#
# Optional, strictly gated model-assisted composition (NOT implemented
# in this prototype build -- reserved for future, separate work). Even
# if enabled, no code path in this build performs a network/model call.
# Leave these as-is (disabled) unless you have explicitly decided to
# extend the prototype with real model calls.

# Set to "true" to opt in to (future) model-assisted composition.
# Default: false (off). Never set to true without deliberately reviewing
# what that would call and what it would cost.
ENABLE_MODEL_CALLS=false

# Which provider to use if ENABLE_MODEL_CALLS=true (e.g. "openai",
# "anthropic"). Not used while ENABLE_MODEL_CALLS=false.
MODEL_PROVIDER=

# Example API key placeholders -- DO NOT put real keys in this example
# file. Copy to .env and fill in locally if you extend this prototype.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
