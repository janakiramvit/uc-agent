# db/ pipeline environment — copy to db/.env (gitignored) and fill in.
# NOTHING in this file is a real credential. db/.env is never committed,
# never echoed to logs, reports, or generated artifacts.

# --- Dev Supabase Postgres (REQUIRED before `--step migrate`) ---
# Direct connection string for a DEVELOPMENT Supabase project only.
# Must have privileges to CREATE SCHEMA, CREATE ROLE, and ALTER TABLE ... ENABLE ROW LEVEL SECURITY.
# Never point this at the production / Vercel-linked project.
DATABASE_URL=

# --- Positive dev-target affirmation (REQUIRED before any DB connection) ---
# Must be exactly "development" (or "dev"). The pipeline refuses to connect otherwise -
# the target has to be positively identified as development, not merely "not prod".
DB_ENVIRONMENT=

# --- Positive dev-host affirmation (REQUIRED before any DB connection) ---
# The EXACT hostname you expect DATABASE_URL to parse to (e.g. db.<ref>.supabase.co, or
# the pooler host if using the Session Pooler). The pipeline refuses to connect unless
# the parsed DATABASE_URL hostname matches this value exactly.
EXPECTED_DEV_HOST=

# --- Production host denylist (OPTIONAL) ---
# Comma-separated real production hostnames/substrings the migrator and dev_teardown.py
# must REFUSE to touch. Leave UNSET if no production database exists yet - do not invent
# a placeholder value. If you do have a real prod project, list its host(s) here.
# Example: db.abcdefgh.supabase.co,prod,production
PROD_HOST_DENYLIST=

# --- Version pins (do not change without a new prompt) ---
PROMPT_VERSION=1.0.0
CANONICAL_SCHEMA_VERSION=1.0.0

# --- Optional: schema name overrides for disposable test runs ---
# Leave unset for normal use. Tests set these to isolated names and tear them down.
# CANONICAL_SCHEMA=canonical
# STAGING_SCHEMA=staging
# QUARANTINE_SCHEMA=quarantine
