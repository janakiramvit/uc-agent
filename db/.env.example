# db/ pipeline environment — copy to db/.env (gitignored) and fill in.
# NOTHING in this file is a real credential. db/.env is never committed,
# never echoed to logs, reports, or generated artifacts.

# --- Dev Supabase Postgres (REQUIRED before `--step migrate`) ---
# Direct connection string for a DEVELOPMENT Supabase project only.
# Must have privileges to CREATE SCHEMA, CREATE ROLE, and ALTER TABLE ... ENABLE ROW LEVEL SECURITY.
# Never point this at the production / Vercel-linked project.
DATABASE_URL=

# --- Production host denylist (REQUIRED before `--step migrate`) ---
# Comma-separated hostnames/substrings the migrator and dev_teardown.py must REFUSE to touch.
# Example: db.abcdefgh.supabase.co,prod,production
PROD_HOST_DENYLIST=

# --- Version pins (do not change without a new prompt) ---
PROMPT_VERSION=1.0.0
CANONICAL_SCHEMA_VERSION=1.0.0

# --- Optional: schema name overrides for disposable test runs ---
# Leave unset for normal use. Tests set these to isolated names and tear them down.
# CANONICAL_SCHEMA=canonical
# STAGING_SCHEMA=staging
# QUARANTINE_SCHEMA=quarantine
